#!/usr/bin/env python
"""BullWatch unified entry point.

Usage:
    python run.py

Starts the Flask dev server on port 34000 with background jobs.
"""
from __future__ import annotations

import os
import sys

# Ensure the project root is on sys.path so that
# legacy_monolith, blueprints/, core/ are importable.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from app import create_app, start_background_jobs
from app.config import Config

app = create_app()


if __name__ == "__main__":
    start_background_jobs()

    print(f"[bullwatch] serving on http://{Config.HOST}:{Config.PORT}  debug={Config.DEBUG}")
    app.run(
        host=Config.HOST,
        port=Config.PORT,
        debug=Config.DEBUG,
        use_reloader=False,
    )
