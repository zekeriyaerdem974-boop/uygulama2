# -------------------- Runtime Thresholds (Parametre Seti) --------------------
# Varsayılan eşikler (runtime'da değiştirilebilir)
DEFAULT_THRESHOLDS = {
    # Günlük aşırı uzama filtresi (change24)
    "overextended_change24_max": 25.0,   # > ise "PULLBACK BEKLE"
    # Minimum momentum filtreleri
    "min_ret7_pct": 5.0,                 # haftalık getiri alt limiti
    "min_change24_pct": 2.0,             # günlük değişim alt limiti (momentum)
    "max_change24_pct": 15.0,            # "ideal" üst sınır; üstü varsa kovalamama (pullback bekle)
    # Kısa TF sıcaklık (EMA uzaklığı)
    "heat_atr_max": 1.5,                 # (price-EMA20_15m)/ATR14_15m <= 1.5
    # Rejim / Trend zorunlulukları
    "require_btc_regime": True,          # BTC: SMA200 üstü ve 50>200
    "require_above200": True,            # Coin: 1D SMA200 üstünde
}

THRESHOLDS_KEY = "runtime_thresholds_v1"

def get_thresholds():
    th = cache_get(THRESHOLDS_KEY, ttl=10**9)
    if th is None:
        th = DEFAULT_THRESHOLDS.copy()
        cache_set(THRESHOLDS_KEY, th)
    return th

def update_thresholds(partial: Dict):
    th = get_thresholds().copy()
    # izin verilen anahtarlar
    allowed = set(DEFAULT_THRESHOLDS.keys())
    for k, v in (partial or {}).items():
        if k in allowed:
            # tip güvenliği: bool alanlar için bool'a döndür
            if k in ("require_btc_regime", "require_above200"):
                th[k] = bool(v)
            else:
                try:
                    th[k] = float(v)
                except Exception:
                    # geçersiz sayı gelirse es geç
                    continue
    cache_set(THRESHOLDS_KEY, th)
    return th

# -------------------- Utilities --------------------
def simple_sma(series, window):
    if len(series) < window:
        return None
    return pd.Series(series).rolling(window=window).mean().iloc[-1]

def safe_float(x):
    try:
        return float(x)
    except Exception:
        return None


# -------------------- Server-side Binance WS (for mobile/light clients) --------------------
BINANCE_TICKER_STREAM = "wss://stream.binance.com:9443/ws/!ticker@arr"
TICKERS_KEY = "binance_top_tickers_v1"

def binance_ticker_ws_loop():
    """Connect to Binance ticker stream and cache top USDT tickers on server."""
    last_emit = 0

    def on_message(wsapp, message):
        nonlocal last_emit
        now = time.time()
        if now - last_emit < 1.0:
            return
        last_emit = now
        try:
            data = json.loads(message)
            if not isinstance(data, list):
                return
            rows = []
            for x in data:
                s = x.get('s')
                if not s or not str(s).endswith('USDT'):
                    continue
                try:
                    chg = float(x.get('P', 0.0))
                    qv = float(x.get('q', 0.0))
                    last = float(x.get('c', 0.0))
                except Exception:
                    continue
                rows.append({"symbol": s, "change24_pct": chg, "quoteVolume": qv, "last": last})

            rows.sort(key=lambda r: -r.get('quoteVolume', 0.0))
            cache_set(TICKERS_KEY, rows[:40])
        except Exception:
            return

    def on_error(wsapp, err):
        print('[binance-ws] error:', err)

    def on_close(wsapp, status_code, msg):
        print('[binance-ws] closed:', status_code, msg)

    while True:
        try:
            wsapp = websocket.WebSocketApp(
                BINANCE_TICKER_STREAM,
                on_message=on_message,
                on_error=on_error,
                on_close=on_close,
            )
            wsapp.run_forever(ping_interval=20, ping_timeout=10)
        except Exception as e:
            print('[binance-ws] loop error:', e)
        time.sleep(2)


@app.get('/api/mobile_snapshot')
def api_mobile_snapshot():
    """Mobile için tek istekle hafif snapshot."""
    return jsonify({
        "ok": True,
        "data": {
            "generated_at": utcnow().isoformat(),
            "tickers": cache_get(TICKERS_KEY, ttl=5) or [],
            "thresholds": get_thresholds(),
        }
    })


@sock.route('/ws/stream')
def ws_stream(ws):
    """Mobile clients: stream cached data (server already pulls from exchanges)."""
    while True:
        payload = {
            "generated_at": utcnow().isoformat(),
            "tickers": cache_get(TICKERS_KEY, ttl=5) or [],
        }
        ws.send(json.dumps({"ok": True, "data": payload}, ensure_ascii=False))
        time.sleep(1)

# -------------------- External APIs --------------------
def binance_klines(symbol="BTCUSDT", interval="1d", limit=400):
    r = requests.get(f"{BINANCE_API}/api/v3/klines",
                     params={"symbol":symbol,"interval":interval,"limit":limit}, timeout=15)
    r.raise_for_status()
    arr = r.json()
    rows = []
    for a in arr:
        rows.append({
            "open_time": int(a[0]), "open": float(a[1]), "high": float(a[2]),
            "low": float(a[3]), "close": float(a[4]), "volume": float(a[5]),
            "close_time": int(a[6])
        })
    return pd.DataFrame(rows)

def fng_latest():
    key = "fng_latest"
    c = cache_get(key, ttl=60)
    if c:
        return c
    r = requests.get(ALT_FNG_API, timeout=10)
    r.raise_for_status()
    data = r.json()
    if data.get("data"):
        it = data["data"][0]
        out = {
            "value": int(it["value"]),
            "value_classification": it["value_classification"],
            "timestamp": int(it["timestamp"]),
            "time_readable": it.get("time_until_update")
        }
        cache_set(key, out)
        return out
    return {"value": None, "value_classification": None, "timestamp": None, "time_readable": None}

def fapi_open_interest(symbol="BTCUSDT"):
    r = requests.get(f"{BINANCE_FAPI}/fapi/v1/openInterest",
                     params={"symbol": symbol}, timeout=10)
    r.raise_for_status()
