TZ = tz.gettz("Europe/Berlin")

# -------------------- Security toggles --------------------
_PRIVATE_NETS = (
    ip_network("127.0.0.0/8"),
    ip_network("10.0.0.0/8"),
    ip_network("172.16.0.0/12"),
    ip_network("192.168.0.0/16"),
)


def _get_client_ip(req) -> str:
    # If behind a reverse proxy, the first X-Forwarded-For entry is the client.
    xf = (req.headers.get("X-Forwarded-For") or "").split(",")[0].strip()
    return xf or (req.remote_addr or "")


def _is_private_client(req) -> bool:
    ip_str = _get_client_ip(req)
    try:
        addr = ip_address(ip_str)
    except Exception:
        return False
    return any(addr in net for net in _PRIVATE_NETS)


def _apk_download_enabled(req) -> bool:
    return os.getenv("BULLWATCH_ENABLE_APK", "0") == "1" and _is_private_client(req)

