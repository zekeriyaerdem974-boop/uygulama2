# ─────────────────────────────────────────────────────────
# BullWatch v2 — Environment Configuration
# Copy this to .env and edit values for your environment.
# ─────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────
# Options: development | testing | production
BULLWATCH_ENV=development

# ── Security ─────────────────────────────────────────────
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-secret-key-here

# ── Server ───────────────────────────────────────────────
BULLWATCH_HOST=0.0.0.0
BULLWATCH_PORT=48200
# BULLWATCH_DEBUG=false

# ── Redis (optional — in-memory cache used if not set) ───
# REDIS_URL=redis://localhost:6379/0

# ── Ollama LLM ───────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434

# ── External APIs ────────────────────────────────────────
# Coinglass API key (optional — for coinbase premium data)
# COINGLASS_API_KEY=your-coinglass-api-key

# ── Refresh Intervals ───────────────────────────────────
CHAT_REFRESH_SEC=60
TOP4H_REFRESH_SEC=900
TOP4H_MAX_SYMBOLS=500
TOP4H_KLINES=500

# ── Rate Limiting ────────────────────────────────────────
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=120/minute

# ── CORS ─────────────────────────────────────────────────
# Comma-separated origins, or "*" for all
CORS_ORIGINS=*

# ── APK Distribution ────────────────────────────────────
# Enable APK download (only works from private networks)
# BULLWATCH_ENABLE_APK=false

# ── Logging ──────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
