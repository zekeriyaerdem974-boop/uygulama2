{% extends "base.html" %}

{% block title %}Trade • BullWatch{% endblock %}

{% block content %}
<style>
  :root{
    --bg:#0b1220;
    --panel:#0f1a2d;
    --panel2:#101f36;
    --border:#1b2a44;
    --text:#e7eefc;
    --muted:#9bb0d1;
    --accent:#7c5cff;
    --good:#2dd4bf;
    --bad:#fb7185;
  }
  body.trade-page main{max-width:none; padding:0;}
  .shell{min-height:100vh; background:var(--bg); color:var(--text); border:1px solid var(--border); border-radius:14px; overflow:hidden; display:flex; flex-direction:column;}
  .topbar{display:flex; gap:10px; align-items:center; padding:10px 12px; background:linear-gradient(180deg,var(--panel),var(--panel2)); border-bottom:1px solid var(--border);}
  .brand{display:flex; gap:10px; align-items:center; font-weight:800; letter-spacing:.3px; white-space:nowrap;}
  .dot{width:10px; height:10px; border-radius:999px; background:var(--accent); box-shadow:0 0 0 4px rgba(124,92,255,.18)}
  .topbar .spacer{flex:1;}
  .search{min-width:240px; max-width:520px; width:100%; padding:9px 10px; background:rgba(255,255,255,.03); border:1px solid var(--border); border-radius:12px; color:var(--text); outline:none;}
  .tf{display:flex; gap:6px; flex-wrap:wrap;}
  .tf button{padding:7px 10px; border:1px solid var(--border); border-radius:999px; background:rgba(255,255,255,.03); color:var(--muted); font-size:12px; cursor:pointer;}
  .tf button.active{color:var(--text); border-color:rgba(124,92,255,.55); background:rgba(124,92,255,.14)}
  .pill{padding:7px 10px; border:1px solid var(--border); border-radius:12px; background:rgba(255,255,255,.03); color:var(--muted); font-size:12px; white-space:nowrap;}

  .grid{flex:1; min-height:0; display:grid; grid-template-columns: 300px 1fr 360px;}
  .left{border-right:1px solid var(--border); background:rgba(255,255,255,.02); overflow:auto;}
  .left-head{padding:10px 12px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;}
  .watch{padding:10px; display:flex; flex-direction:column; gap:8px;}
  .item{padding:10px 10px; border:1px solid var(--border); border-radius:12px; background:rgba(255,255,255,.02); cursor:pointer; display:flex; justify-content:space-between; gap:10px; align-items:center;}
  .item:hover{border-color:rgba(124,92,255,.55)}
  .item.active{border-color:rgba(124,92,255,.75); box-shadow:0 0 0 3px rgba(124,92,255,.12) inset}
  .sym{font-weight:700;}
  .muted{color:var(--muted); font-size:12px;}
  .chg.good{color:var(--good)}
  .chg.bad{color:var(--bad)}

  .center{min-width:0; display:flex; flex-direction:column;}
  .center-head{padding:10px 12px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:flex-start; gap:10px;}
  .title{font-weight:800; font-size:16px;}
  .sub{color:var(--muted); font-size:12px; margin-top:2px;}
  .charts{flex:1; min-height:0; display:flex; flex-direction:column;}
  .chart-main{flex:1; min-height:280px; background:#000;}
  .chart-panels{display:grid; grid-template-columns: 1fr 1fr 1fr; gap:10px; padding:10px; border-top:1px solid var(--border); background:rgba(255,255,255,.01);}
  .panelChart{height:160px; background:#000; border:1px solid var(--border); border-radius:12px; overflow:hidden;}

  .right{border-left:1px solid var(--border); background:rgba(255,255,255,.02); overflow:auto;}
  .right-inner{padding:12px; display:flex; flex-direction:column; gap:12px;}
  .card{border:1px solid var(--border); border-radius:14px; background:rgba(255,255,255,.02); padding:12px;}
  .card h3{margin:0 0 8px 0; font-weight:800; font-size:13px; color:var(--text);}
  .row{display:flex; gap:8px; align-items:center;}
  .btn{padding:9px 10px; border:1px solid var(--border); border-radius:12px; background:rgba(255,255,255,.03); color:var(--text); font-size:12px; cursor:pointer;}
  .btn:hover{border-color:rgba(124,92,255,.55)}
  .input{width:100%; padding:9px 10px; background:rgba(255,255,255,.03); border:1px solid var(--border); border-radius:12px; color:var(--text); outline:none; font-size:12px;}
  .aiOut{white-space:pre-wrap; color:var(--text); font-size:12px; line-height:1.45;}
  .kv{display:grid; grid-template-columns: 1fr auto; gap:6px 10px; font-size:12px;}
  .kv .k{color:var(--muted)}
  .kv .v{color:var(--text); font-variant-numeric: tabular-nums;}

  @media (max-width: 1100px){
    .grid{grid-template-columns: 280px 1fr;}
    .right{display:none;}
  }
  @media (max-width: 820px){
    .grid{grid-template-columns: 1fr;}
    .left{display:none;}
    .shell{border-radius:0; border-left:0; border-right:0;}
  }
</style>

<div class="shell" id="shell">
  <div class="topbar">
    <div class="brand"><span class="dot"></span> BullWatch Trade</div>
    <div class="spacer"></div>
    <input id="symbolSearch" class="search" placeholder="Sembol ara (BTCUSDT, ETHUSDT...)" />
    <div class="tf" id="tf"></div>
    <button class="btn" id="refreshAll">Refresh</button>
    <div class="pill" id="status">Bağlantı: —</div>
  </div>

  <div class="grid">
    <aside class="left">
      <div class="left-head">
        <div>
          <div style="font-weight:800">Watchlist</div>
          <div class="muted">Futures 24h (unified)</div>
        </div>
        <button class="btn" id="refreshWatch">Yenile</button>
      </div>
      <div class="watch" id="watch"></div>
    </aside>

    <section class="center">
      <div class="center-head">
        <div>
          <div class="title" id="title">—</div>
          <div class="sub" id="sub">—</div>
        </div>
        <div class="muted" id="meta">—</div>
      </div>
      <div class="charts">
        <div id="chartMain" class="chart-main"></div>
        <div class="chart-panels">
          <div class="panelChart" id="chartVol"></div>
          <div class="panelChart" id="chartRsi"></div>
          <div class="panelChart" id="chartMacd"></div>
        </div>
      </div>
    </section>

    <aside class="right">
      <div class="right-inner">
        <div class="card">
          <h3>Order Panel (UI)</h3>
          <div class="muted">Bu panel demo/placeholder. Emir gönderme eklenmedi.</div>
          <div class="row" style="margin-top:10px;">
            <input id="qty" class="input" placeholder="Miktar" />
            <button class="btn" id="buyBtn">AL</button>
            <button class="btn" id="sellBtn">SAT</button>
          </div>
          <div class="muted" style="margin-top:8px;" id="lastPx">Fiyat: —</div>
        </div>

        <div class="card">
          <h3>Alpha</h3>
          <div class="kv" id="alphaKv">
            <div class="k">Status</div><div class="v" id="alphaStatus">—</div>
            <div class="k">Universe</div><div class="v" id="alphaUniverse">—</div>
            <div class="k">Selected</div><div class="v" id="alphaSelected">—</div>
          </div>
        </div>

        <div class="card">
          <h3>Orderflow (Proxy)</h3>
          <div class="kv" id="ofKv">
            <div class="k">Trend</div><div class="v" id="ofTrend">—</div>
            <div class="k">Vol (N)</div><div class="v" id="ofVol">—</div>
            <div class="k">Now/Avg</div><div class="v" id="ofRatio">—</div>
          </div>
          <div class="muted" style="margin-top:8px;">Not: Gerçek orderflow feed entegrasyonu sonraki fazda; şu an kline/volume üzerinden proxy özet.</div>
        </div>

        <div class="card">
          <h3>Liquidation (Summary)</h3>
          <div class="kv" id="liqKv">
            <div class="k">24h</div><div class="v" id="liqChg">—</div>
            <div class="k">QuoteVol</div><div class="v" id="liqVol">—</div>
            <div class="k">Rank</div><div class="v" id="liqRank">—</div>
          </div>
        </div>

        <div class="card">
          <h3>AI Analiz</h3>
          <div class="row">
            <button class="btn" id="aiAnalyze">Analiz Et</button>
            <button class="btn" id="aiClear">Temizle</button>
          </div>
          <div class="aiOut" id="aiOut" style="margin-top:10px;">—</div>
        </div>

        <div class="card">
          <h3>Kısayollar</h3>
          <div class="row" style="flex-wrap:wrap;">
            <a class="btn" href="/tv">TV</a>
            <a class="btn" href="/sim/mobile">Telefon Sim</a>
            <a class="btn" href="/chat">Chat</a>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
<script type="module" src="{{ url_for('static', filename='js/trade.js') }}"></script>
<script>document.body.classList.add('trade-page');</script>
{% endblock %}
