# -------------------- Main --------------------
if __name__ == "__main__":
    # İlk thresholds yükle
    cache_set(THRESHOLDS_KEY, DEFAULT_THRESHOLDS.copy())

    # chat_context'i startup'ta senkron çekme (network/timeout yüzünden açılışı kilitlemesin)
    cache_set("chat_context", {"generated_at": utcnow().isoformat(), "status": "warming_up"})
    warm_chat_context_async()

    # Background thread'leri başlat
    threading.Thread(target=binance_ticker_ws_loop, daemon=True).start()
    threading.Thread(target=refresh_loop, daemon=True).start()
    threading.Thread(target=refresh_top4h_loop, daemon=True).start()

    debug = os.getenv("BULLWATCH_DEBUG", "0") == "1"
    app.run(debug=debug, use_reloader=False, port=34000, host="0.0.0.0")
